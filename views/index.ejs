<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<!-- ════════════ TOP NAV ════════════ -->
<nav class="topnav">
  <div class="topnav-inner">
    <div class="topnav-left">
      <a href="#" class="logo" aria-label="EventPulse">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="8" fill="#CDC13B"/>
          <path d="M8 16c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8" stroke="#0A0B0D" stroke-width="3" stroke-linecap="round"/>
          <circle cx="16" cy="16" r="3" fill="#0A0B0D"/>
        </svg>
        <span class="logo-text">EventPulse</span>
      </a>
      <div class="nav-links">
        <a href="#" class="nav-link">Discover</a>
        <a href="#" class="nav-link active">Events</a>
        <a href="#" class="nav-link">Community</a>
      </div>
    </div>
    <div class="topnav-right">
      <a class="btn-submit-event" href="/submit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="2" x2="8" y2="14"/><line x1="2" y1="8" x2="14" y2="8"/></svg>
        Submit Event
      </a>
      <button class="avatar-btn" aria-label="User menu">
        <div class="avatar-placeholder">D</div>
      </button>
    </div>
  </div>
</nav>

<!-- ════════════ HERO ════════════ -->
<header class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <h1>Events</h1>
      <p class="hero-sub">X Spaces, AMAs, token launches & more from the meme coin community</p>
    </div>
    <div class="hero-stats">
      <div class="stat-pill">
        <span class="stat-dot live"></span>
        <span>2 Live Now</span>
      </div>
      <div class="stat-pill">
        <span>12 This Week</span>
      </div>
    </div>
  </div>
</header>

<!-- ════════════ MAIN CONTENT ════════════ -->
<main class="main">
  <div class="main-inner">

    <!-- LEFT: SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-section">
        <h3 class="sidebar-label">Categories</h3>
        <ul class="cat-list" role="list">
          <li><button class="cat-item active" data-cat="all"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>All Events<span class="cat-count">52</span></button></li>
          <li><button class="cat-item" data-cat="xspaces"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>X Spaces<span class="cat-count">15</span></button></li>
          <li><button class="cat-item" data-cat="ama"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>AMAs<span class="cat-count">10</span></button></li>
          <li><button class="cat-item" data-cat="exchange"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>Exchange Listings<span class="cat-count">8</span></button></li>
          <li><button class="cat-item" data-cat="livestream"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="15" height="10" rx="2"/><path d="M17 10l5-3v10l-5-3z"/></svg>Livestreams<span class="cat-count">0</span></button></li>
          <li><button class="cat-item" data-cat="other"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>Other<span class="cat-count">12</span></button></li>
        </ul>
      </div>

      <div class="sidebar-section">
        <h3 class="sidebar-label">Quick Filters</h3>
        <div class="quick-filters">
          <button class="qf active">Today</button>
          <button class="qf">This Week</button>
          <button class="qf">This Month</button>
        </div>
      </div>

      <div class="sidebar-section sidebar-ad">
        <span class="sidebar-label">Sponsored</span>
        <div class="ad-slot">
          <span>Your ad here</span>
        </div>
      </div>
    </aside>

    <!-- CENTER: EVENT FEED -->
    <section class="feed">
      <!-- Tabs & Search -->
      <div class="feed-toolbar">
        <div class="feed-tabs">
          <button class="tab" data-tab="today">Today <span class="tab-badge" id="todayTabCount">0</span></button>
          <button class="tab active" data-tab="all">All Events</button>
          <button class="tab">Upcoming</button>
          <button class="tab">Past</button>
        </div>
        <div class="feed-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" placeholder="Search events..." aria-label="Search events">
        </div>
      </div>

      <!-- Events will be rendered here -->
    </section>

    <!-- RIGHT: CALENDAR & MAP -->
    <aside class="sidebar-right">
      <div class="mini-calendar">
        <div class="cal-header">
          <button class="cal-nav" aria-label="Previous month">&lsaquo;</button>
          <span class="cal-month">March 2026</span>
          <button class="cal-nav" aria-label="Next month">&rsaquo;</button>
        </div>
        <div class="cal-grid">
          <span class="cal-day-label">Su</span>
          <span class="cal-day-label">Mo</span>
          <span class="cal-day-label">Tu</span>
          <span class="cal-day-label">We</span>
          <span class="cal-day-label">Th</span>
          <span class="cal-day-label">Fr</span>
          <span class="cal-day-label">Sa</span>
          <span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day">1</span>
          <span class="cal-day">2</span><span class="cal-day">3</span><span class="cal-day">4</span><span class="cal-day has-event">5</span><span class="cal-day">6</span><span class="cal-day has-event">7</span><span class="cal-day">8</span>
          <span class="cal-day">9</span><span class="cal-day has-event">10</span><span class="cal-day">11</span><span class="cal-day has-event">12</span><span class="cal-day">13</span><span class="cal-day has-event">14</span><span class="cal-day">15</span>
          <span class="cal-day">16</span><span class="cal-day">17</span><span class="cal-day has-event">18</span><span class="cal-day">19</span><span class="cal-day today has-event">20</span><span class="cal-day has-event">21</span><span class="cal-day">22</span>
          <span class="cal-day has-event">23</span><span class="cal-day">24</span><span class="cal-day has-event">25</span><span class="cal-day">26</span><span class="cal-day">27</span><span class="cal-day has-event">28</span><span class="cal-day">29</span>
          <span class="cal-day">30</span><span class="cal-day">31</span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span><span class="cal-day"></span>
        </div>
      </div>

      <div class="sidebar-right-tabs">
        <button class="srt active">Upcoming</button>
        <button class="srt">Past</button>
      </div>

      <div class="quick-upcoming">
        <!-- Will be populated dynamically -->
      </div>

      <div class="submit-cta">
        <a class="btn-submit-event" href="/submit">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="2" x2="8" y2="14"/><line x1="2" y1="8" x2="14" y2="8"/></svg>
          Submit Event
        </a>
      </div>
    </aside>
  </div>
</main>

<!-- ════════════ EVENT DETAIL — FLOATING OVERLAY ════════════ -->
<div class="modal-backdrop" id="modalBackdrop" onclick="closeModal()"></div>
<div class="modal-panel" id="modalPanel" aria-hidden="true" role="dialog" aria-label="Event details">
  <div class="modal-toolbar">
    <div class="modal-toolbar-left">
      <button class="modal-nav-btn" onclick="navigateEvent(-1)" aria-label="Previous event">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
      </button>
      <button class="modal-nav-btn" onclick="navigateEvent(1)" aria-label="Next event">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>
    <div class="modal-toolbar-right">
      <button class="modal-action-btn" onclick="copyLink()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        Copy Link
      </button>
      <button class="modal-close" onclick="closeModal()" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div class="modal-scroll" id="modalScroll">
    <!-- Hero / Thumbnail -->
    <div class="modal-hero" id="modalHero">
      <img id="modalHeroImg" src="" alt="" class="modal-hero-img">
      <div class="modal-hero-fallback" id="modalHeroFallback">
        <span class="modal-hero-emoji" id="modalEmoji">🐕</span>
      </div>
    </div>

    <!-- Body -->
    <div class="modal-body">
      <div class="modal-type-row">
        <span class="event-type-badge space" id="modalTypeBadge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>
          <span id="modalTypeText">X Space</span>
        </span>
        <span class="modal-live-badge" id="modalLiveBadge">
          <span class="pulse-dot"></span> LIVE
        </span>
      </div>

      <h2 class="modal-title" id="modalTitle">Dogecoin Community Call</h2>

      <div class="modal-host-row" id="modalHostRow">
        <div class="host-avatar" id="modalHostAvatar">DF</div>
        <span>Hosted by <strong id="modalHostName">Dogecoin Foundation</strong></span>
      </div>

      <!-- Info Cards -->
      <div class="modal-info-cards">
        <div class="modal-info-card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <div>
            <span class="info-label">Date & Time</span>
            <span class="info-value" id="modalDate">Friday, March 20, 2026</span>
            <span class="info-sub" id="modalTime">2:00 PM — 3:30 PM EET</span>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="modal-cta-section">
        <button class="btn-join" id="modalJoinBtn">
          <span>Join Space</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </button>
      </div>

      <!-- About -->
      <div class="modal-section">
        <h3>About</h3>
        <p class="modal-about" id="modalAbout">Weekly community discussion about DOGE ecosystem updates.</p>
      </div>

      <!-- Related Token -->
      <div class="modal-section">
        <h3>Related Token</h3>
        <div class="modal-coin-info">
          <span class="coin-tag-lg" id="modalCoin">DOGE</span>
          <span class="modal-coin-link">View on Capitoday &rarr;</span>
        </div>
      </div>

      <!-- Created By -->
      <div class="modal-section">
        <h3>Created By</h3>
        <div class="modal-presenter">
          <p style="color: var(--text-faint); font-size: 13px;">&nbsp;</p>
        </div>
      </div>

      <!-- Tags -->
      <div class="modal-section">
        <div class="modal-tags" id="modalTags">
          <span class="modal-tag"># memecoins</span>
          <span class="modal-tag"># dogecoin</span>
          <span class="modal-tag"># community</span>
        </div>
      </div>

      <!-- Footer Links -->
      <div class="modal-footer-links">
        <a href="#">Contact the Host</a>
        <a href="#">Report Event</a>
      </div>
    </div>
  </div>
</div>

<!-- ════════════ FOOTER ════════════ -->
<footer class="site-footer">
  <div class="footer-inner">
    <span>&copy; 2026 Capitoday</span>
    <a href="https://capitoday.com" target="_blank" rel="noopener noreferrer">Capitoday Events</a>
  </div>
</footer>

<script src="/script.js"></script>
</body>
</html>
